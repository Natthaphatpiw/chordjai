# Backend project: all microservices share this environment.
# Supabase project > Connect > Transaction pooler. Copy the exact host/username.
# Replace the password placeholder with a URL-encoded database password; keep SSL.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require"
APP_ORIGIN=https://www.chordjai.life
API_ORIGIN=https://api.chordjai.life
ALLOWED_ORIGINS=https://www.chordjai.life,https://clinic.chordjai.life,https://admin.chordjai.life
APP_JWT_ISSUER=https://www.chordjai.life
APP_JWT_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CRON_SECRET=YOUR_OTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
## LINE agent: apply migration 22 before enabling. Existing LINE webhook stays unchanged.
LINE_AGENT_ENABLED=false
# Optional; falls back to LIFF_ID. Public owner LIFF identifier, not a secret.
LINE_AGENT_LIFF_ID=2010549060-FRfLt9mJ
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_DAILY_BUDGET_USD=5
# Pricing fields are configurable; verify actual model prices in your account.
AI_INPUT_USD_PER_MILLION=2
AI_OUTPUT_USD_PER_MILLION=10
LINE_CHANNEL_ID=2009341751
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Optional epoch milliseconds for a short-lived token. Blank token uses automatic stateless auth.
LINE_TOKEN_EXPIRES_AT=
LINE_LOGIN_CHANNEL_ID=2010549060
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ACCESS_TOKEN=
LIFF_ID=2010549060-FRfLt9mJ
LIFF_ENDPOINT=https://www.chordjai.life/app
LINE_WEBHOOK_URL=https://www.chordjai.life/api/v1/notification/webhooks/line
BLOB_READ_WRITE_TOKEN=
# NOTIFICATION_INTERNAL_URL is injected by Vercel Services; do not set manually on Vercel.
# Local fallback is http://localhost:8787
API_PORT=8787

# Private operations dashboard at https://admin.chordjai.life/dashboard
# Generate a unique password + hash with: node scripts/create-dashboard-login.mjs
# Copy the generated ignored local-secrets/dashboard-backend.env here / into Vercel backend.
ADMIN_DASHBOARD_USERNAME=
ADMIN_DASHBOARD_PASSWORD_HASH=
ADMIN_DASHBOARD_ORIGIN=https://admin.chordjai.life
# Budget admission caps. Per-user default is $0.50/day; 0 explicitly disables that cap.
AI_USER_DAILY_BUDGET_USD=0.50
AI_MONTHLY_BUDGET_USD=0
# Standard API rate supplements (USD / 1M tokens), checked 2026-10-30.
AI_CACHED_INPUT_USD_PER_MILLION=0.10
AI_CACHE_WRITE_USD_PER_MILLION=2.50
AI_EMBEDDING_USD_PER_MILLION=0.02
# Set only if your API agreement / processing region adds a known multiplier.
AI_PRICE_MULTIPLIER=1

# Input screening uses gpt-6-luna; main generation stays gpt-6.1-sol.
# Apply upgrade.sql schema 26 before deploying this release. All values below are defaults.
AI_LUNA_INPUT_USD_PER_MILLION=0.10
AI_LUNA_OUTPUT_USD_PER_MILLION=0.50
AI_LUNA_CACHED_INPUT_USD_PER_MILLION=0.01
AI_LUNA_CACHE_WRITE_USD_PER_MILLION=0.125
AI_CALLS_PER_MINUTE=20
AI_GLOBAL_CALLS_PER_MINUTE=300
LINE_USER_BURST=6
LINE_USER_EVENTS_PER_DAY=150
LINE_EVENTS_PER_MINUTE=600
ABUSE_WRITE_PER_MINUTE=60
ABUSE_WRITE_PER_DAY=500
ABUSE_READ_PER_MINUTE=240
ABUSE_PUBLIC_PER_MINUTE=600
ABUSE_PUBLIC_IP_PER_MINUTE=120
ABUSE_WARM_PER_10_SECONDS=120
