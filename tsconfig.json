{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "noEmit": true, "types": ["node"], "allowImportingTsExtensions": true
  },
  "include": ["backend/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "frontend", "**/dist"]
}
